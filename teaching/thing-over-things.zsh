#!/usr/bin/env zsh
# The top of the ladder, said over the things themselves.
#
# The corpus states that an object, an animal, a plant and nine other classes are things.
# A stated rung writes no grounding, so the climb that answers an is-a question cannot use
# it: of the 414 percepts that should reach `thing`, the 47 one lesson said it over are
# exactly the 47 that do. This lesson says it over the other 367.
#
# WHY NOT ONE RUNG ABOVE THE CLASSES, which is the shape the ladder deserves. Binding a word
# to a class rather than to a thing needs the class warm and nothing else, and on a brain
# this size that does not hold: warming a class surfaces its own thickest members, and a word
# told into that workspace lands on a carrot and a banana rather than on the class. Measured
# on this brain, with the idle voice quiet and lateral inhibition raised to 0.95, the classes
# reached 0.09 to 0.12 while the two members sat at 0.20 and the abstraction cored on them.
# So the rung goes over the percepts, where ostension is reliable, and the flat shape is the
# price of a binding that actually lands.
#
# The word is `thing`, which the corpus already states these rungs with. It is also seeded as
# sortal:en:thing, and the nightly grammar competition has already taken that node to its 0.05
# floor on the 47 sayings that exist, so this lesson cannot lower it further. Nothing reads it
# that matters here: the definition path renders "a thing" from a fixed word, not from the
# node, and this brain answers "what is a dog" and "is a dog a thing" correctly with the node
# already at the floor.
#
#   GOLEM=golem zsh thing-over-things.zsh
set -u
GOLEM=${GOLEM:-golem}
PAUSE=${PAUSE:-6}

log()  { print -r -- "$(date +%H:%M:%S) $*" }
fobs() { local i; for i in 1 2 3; do $GOLEM observe --force vision "$1" >/dev/null 2>&1 && { sleep 0.15; return 0 }; sleep 1; done; return 0 }
sayw() { local i; for i in 1 2 3; do $GOLEM tell "$1" >/dev/null 2>&1 && { sleep 0.15; return 0 }; sleep 1; done; return 0 }
nap()  { log "(nap: consolidate)"; $GOLEM sleep >/dev/null 2>&1; sleep "${BLOCKGAP:-6}" }

# THE WAIT BELONGS TO THE CHANGE OF PERCEPT. A told word binds to whatever is still inside
# the attention window, so a rung said over one thing while the thing before it is still in
# the window is a rung said over both. Showing the same thing again needs no wait, being the
# same thing looked at twice, so a percept's showings sit together and the window is cleared
# once per thing. The name is said on every showing and the rung only on the later two, so
# the rung gains the company it needs without unseating the name.
revisit() {
  local cap=$1 nm=$2 i
  sleep $PAUSE
  fobs "$cap"; sayw "$nm"
  for i in 1 2; do fobs "$cap"; sayw "$nm"; sayw "thing"; done
}

$GOLEM status >/dev/null 2>&1 || { log "daemon unreachable at $GOLEM"; exit 1 }
log "########## thing over the things begins ##########"


